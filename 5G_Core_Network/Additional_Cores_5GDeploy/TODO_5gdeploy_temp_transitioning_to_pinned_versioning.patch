+# Parse command line arguments for optional tags
+declare -A TAGS=( [eupf]="" [free5gc]="" [oai]="" [open5gs]="" )
+
+while [[ $# -gt 0 ]]; do
+  case "$1" in
+    --eupf-tag)
+      TAGS[eupf]="$2"
+      msg "Using EUPF tag: ${TAGS[eupf]}"
+      shift 2
+      ;;
+    --free5gc-tag)
+      TAGS[free5gc]="$2"
+      msg "Using Free5GC tag: ${TAGS[free5gc]}"
+      shift 2
+      ;;
+    --oai-tag)
+      TAGS[oai]="$2"
+      msg "Using OAI tag: ${TAGS[oai]}"
+      shift 2
+      ;;
+    --open5gs-tag)
+      TAGS[open5gs]="$2"
+      msg "Using Open5GS tag: ${TAGS[open5gs]}"
+      shift 2
+      ;;
+    *)
+      shift
+      ;;
+  esac
+done
+
 if ! docker version &>/dev/null; then
   die Unable to access Docker, check docker group membership
 fi
