+/**
+ * @brief Set contents of 5GMM capability
+ * @note  Currently hardcoded, sending min length only (1 octet)
+ */
+static FGMMCapability set_fgmm_capability()
+{
+  FGMMCapability cap = {0};
+  cap.iei = REGISTRATION_REQUEST_5GMM_CAPABILITY_IEI;
+  cap.length = 1;
+
+  cap.sgc = 0;
+  cap.iphc_cp_cIoT = 0;
+  cap.n3_data = 0;
+  cap.cp_cIoT = 0;
+  cap.restrict_ec = 0;
+  cap.lpp = 1;
+  cap.ho_attach = 1;
+  cap.s1_mode = 0;
+
+  if (cap.length == 1)
+    return cap; // Send minimum length only, 1 octet
+
+  cap.racs = 0;
+  cap.nssaa = 0;
+  cap.lcs = 0;
+  cap.v2x_cnpc5 = 0;
+  cap.v2x_cepc5 = 0;
+  cap.v2x = 0;
+  cap.up_cIoT = 0;
+  cap.srvcc = 0;
+  cap.ehc_CP_ciot = 0;
+  cap.multiple_eUP = 0;
+  cap.wusa = 0;
+  cap.cag = 0;
+
+  return cap;
+}
