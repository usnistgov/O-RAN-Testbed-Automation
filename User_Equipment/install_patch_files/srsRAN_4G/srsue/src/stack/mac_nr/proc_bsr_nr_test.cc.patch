+int new_data_trigger_test()
+{
+  auto& mac_logger = srslog::fetch_basic_logger("MAC");
+
+  srsran::task_scheduler        task_sched{5, 2};
+  srsran::ext_task_sched_handle ext_task_sched_h(&task_sched);
+  dummy_phy                     phy;
+  dummy_rrc                     rrc;
+  dummy_mac                     mac;
+  dummy_mux                     mux;
+  proc_sr_nr                    sr(mac_logger);
+  sr.init(&mac, &phy, &rrc);
+
+  proc_bsr_nr proc(mac_logger);
+  proc.init(&sr, &mux, nullptr, &ext_task_sched_h);
+
+  mac_buffer_states_t buffer_state;
+  buffer_state.nof_lcgs_with_data = 1;
+  buffer_state.last_non_zero_lcg  = 1;
+  buffer_state.lcg_buffer_size[1] = 10;
+
+  proc.step(0, buffer_state);
+  TESTASSERT(mux.nof_bsr_mac_ces == 0);
+
+  proc.new_grant_ul(32);
+  TESTASSERT(mux.nof_bsr_mac_ces == 1);
+  TESTASSERT(mux.last_format == srsran::bsr_format_nr_t::SHORT_BSR);
+
+  return SRSRAN_SUCCESS;
+}
+
+int lcid_priority_tests()
+{
+  auto& mac_logger = srslog::fetch_basic_logger("MAC");
+
+  srsran::task_scheduler        task_sched{5, 2};
+  srsran::ext_task_sched_handle ext_task_sched_h(&task_sched);
+  proc_bsr_nr                   proc(mac_logger);
+  dummy_phy                     phy;
+  dummy_rrc                     rrc;
+  dummy_mac                     mac;
+  dummy_mux                     mux;
+  proc_sr_nr                    sr(mac_logger);
+  sr.init(&mac, &phy, &rrc);
+  proc.init(&sr, &mux, nullptr, &ext_task_sched_h);
+
+  TESTASSERT(proc.setup_lcid(1, 1, 10) == SRSRAN_SUCCESS);
+  TESTASSERT(proc.setup_lcid(2, 1, 10) == SRSRAN_SUCCESS);
+  TESTASSERT(proc.setup_lcid(3, 2, 10) == SRSRAN_ERROR);
+
+  return SRSRAN_SUCCESS;
+}
