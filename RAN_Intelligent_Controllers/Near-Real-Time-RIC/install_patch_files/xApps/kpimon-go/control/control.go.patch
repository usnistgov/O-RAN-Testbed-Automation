+func (c Control) getRouteReadyNodes() map[string]bool {
+	ready := make(map[string]bool)
+	response, err := http.Get("http://service-ricplt-submgr-http.ricplt:8080/ric/v1/get_all_e2nodes")
+	if err != nil {
+		xapp.Logger.Error("Unable to read route-ready E2 nodes from SubMgr: %v", err)
+		return ready
+	}
+	defer response.Body.Close()
+	if response.StatusCode != http.StatusOK {
+		xapp.Logger.Error("SubMgr returned %s while reading route-ready E2 nodes", response.Status)
+		return ready
+	}
+
+	var nodeNames []string
+	if err = json.NewDecoder(response.Body).Decode(&nodeNames); err != nil {
+		xapp.Logger.Error("Unable to decode route-ready E2 nodes from SubMgr: %v", err)
+		return ready
+	}
+	for _, nodeName := range nodeNames {
+		ready[nodeName] = true
 	}
+	return ready
+}
