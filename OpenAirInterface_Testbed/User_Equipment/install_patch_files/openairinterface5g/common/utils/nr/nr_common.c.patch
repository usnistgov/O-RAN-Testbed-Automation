+/** @brief 38.133 Table 10.1.16.1-1: SS-SINR and CSI-SINR measurement report mapping */
+uint8_t get_sinr_index(float sinr_dB)
+{
+  if (isnan(sinr_dB) || sinr_dB < -23.0f)
+    return 0;
+  if (sinr_dB >= 40.0f)
+    return 127;
+  return (uint8_t)(2.0f * sinr_dB + 47.0f);
+}
