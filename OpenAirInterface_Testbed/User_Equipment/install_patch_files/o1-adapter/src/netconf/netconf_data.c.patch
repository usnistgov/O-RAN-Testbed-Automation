+static int netconf_data_f1_handover_rpc_callback(sr_session_ctx_t *session, uint32_t sub_id, const char *xpath, const sr_val_t *input, const size_t input_cnt, sr_event_t event, uint32_t request_id, sr_val_t **output, size_t *output_cnt, void *private_data) {
+    (void)session;
+    (void)sub_id;
+    (void)xpath;
+    (void)event;
+    (void)request_id;
+    (void)private_data;
+
+    int rrc_ue_id = -1; // Default: auto-select
+    int ho_allowed = 1; // Default: allow if attribute missing
+    if (NRCELLDU_XPATH) {
+        char *path = 0;
+        sr_val_t *val = 0;
+        asprintf(&path, "%s/attributes/isHOAllowed", NRCELLDU_XPATH);
+        if (path) {
+            int grc = sr_get_item(netconf_session_running, path, 0, &val);
+            if (grc == SR_ERR_OK && val && val->type == SR_BOOL_T) {
+                ho_allowed = val->data.bool_val ? 1 : 0;
+            } else {
+                if (val) { sr_free_val(val); val = 0; }
+                grc = sr_get_item(netconf_session_operational, path, 0, &val);
+                if (grc == SR_ERR_OK && val && val->type == SR_BOOL_T) {
+                    ho_allowed = val->data.bool_val ? 1 : 0;
+                }
+            }
+        }
+        if (val) { sr_free_val(val); }
+        free(path);
+    }
+    if (!ho_allowed) {
+        log_error("F1 HO rejected: isHOAllowed=false as per 3GPP NRM");
+        return SR_ERR_VALIDATION_FAILED;
+    }
+
+    // Parse input parameters
+    for (size_t i = 0; i < input_cnt; i++) {
+        if (strcmp(input[i].xpath, "/oai-handover:trigger-f1-handover/rrc-ue-id") == 0) {
+            rrc_ue_id = input[i].data.int32_val;
+        }
+    }
+
+    log("F1 Handover RPC called with rrc_ue_id=%d", rrc_ue_id);
+
+    int rc = telnet_trigger_f1_handover(rrc_ue_id);
+    if (rc != 0) {
+        log_error("telnet_trigger_f1_handover failed");
+        return SR_ERR_OPERATION_FAILED;
+    }
+
+    *output_cnt = 1;
+    *output = calloc(*output_cnt, sizeof(**output));
+    if(!*output) {
+        log_error("calloc failed for RPC output");
+        return SR_ERR_OPERATION_FAILED;
+    }
+    (*output)[0].xpath = strdup("/oai-handover:trigger-f1-handover/status");
+    (*output)[0].type = SR_STRING_T;
+    (*output)[0].data.string_val = strdup("success");
+    if(!(*output)[0].xpath || !(*output)[0].data.string_val) {
+        log_error("strdup failed for RPC output");
+        return SR_ERR_OPERATION_FAILED;
+    }
+
+    return SR_ERR_OK;
+}
+
+static int netconf_data_n2_handover_rpc_callback(sr_session_ctx_t *session, uint32_t sub_id, const char *xpath, const sr_val_t *input, const size_t input_cnt, sr_event_t event, uint32_t request_id, sr_val_t **output, size_t *output_cnt, void *private_data) {
+    (void)session;
+    (void)sub_id;
+    (void)xpath;
+    (void)event;
+    (void)request_id;
+    (void)private_data;
+
+    int neighbour_pci = -1;
+    int ue_id = -1;
+
+    int ho_allowed = 1; // Default: allow if attribute missing
+    if (NRCELLDU_XPATH) {
+        char *path = 0;
+        sr_val_t *val = 0;
+        asprintf(&path, "%s/attributes/isHOAllowed", NRCELLDU_XPATH);
+        if (path) {
+            int grc = sr_get_item(netconf_session_running, path, 0, &val);
+            if (grc == SR_ERR_OK && val && val->type == SR_BOOL_T) {
+                ho_allowed = val->data.bool_val ? 1 : 0;
+            } else {
+                if (val) { sr_free_val(val); val = 0; }
+                grc = sr_get_item(netconf_session_operational, path, 0, &val);
+                if (grc == SR_ERR_OK && val && val->type == SR_BOOL_T) {
+                    ho_allowed = val->data.bool_val ? 1 : 0;
+                }
+            }
+        }
+        if (val) { sr_free_val(val); }
+        free(path);
+    }
+    if (!ho_allowed) {
+        log_error("N2 HO rejected: isHOAllowed=false as per 3GPP NRM");
+        return SR_ERR_VALIDATION_FAILED;
+    }
+
+    // Parse input parameters
+    for (size_t i = 0; i < input_cnt; i++) {
+        if (strcmp(input[i].xpath, "/oai-handover:trigger-n2-handover/neighbour-pci") == 0) {
+            neighbour_pci = input[i].data.int32_val;
+        } else if (strcmp(input[i].xpath, "/oai-handover:trigger-n2-handover/ue-id") == 0) {
+            ue_id = input[i].data.int32_val;
+        }
+    }
+
+    if (neighbour_pci < 0 || ue_id < 0) {
+        log_error("N2 Handover RPC: missing required parameters");
+        return SR_ERR_INVAL_ARG;
+    }
+
+    log("N2 Handover RPC called with neighbour_pci=%d, ue_id=%d", neighbour_pci, ue_id);
+
+    int rc = telnet_trigger_n2_handover(neighbour_pci, ue_id);
+    if (rc != 0) {
+        log_error("telnet_trigger_n2_handover failed");
+        return SR_ERR_OPERATION_FAILED;
+    }
+
+    *output_cnt = 1;
+    *output = calloc(*output_cnt, sizeof(**output));
+    if(!*output) {
+        log_error("calloc failed for RPC output");
+        return SR_ERR_OPERATION_FAILED;
+    }
+    (*output)[0].xpath = strdup("/oai-handover:trigger-n2-handover/status");
+    (*output)[0].type = SR_STRING_T;
+    (*output)[0].data.string_val = strdup("success");
+    if(!(*output)[0].xpath || !(*output)[0].data.string_val) {
+        log_error("strdup failed for RPC output");
+        return SR_ERR_OPERATION_FAILED;
+    }
+
+    return SR_ERR_OK;
+}
+
+int netconf_data_register_handover_rpcs() {
+    int rc;
+
+    // Ensure subscription context to reuse for multiple RPCs
+    if(netconf_rpc_subscription) {
+        sr_unsubscribe(netconf_rpc_subscription);
+        netconf_rpc_subscription = 0;
+    }
+
+    // Subscribe to F1 handover RPC
+    rc = sr_rpc_subscribe(netconf_session_running,
+                          "/oai-handover:trigger-f1-handover",
+                          netconf_data_f1_handover_rpc_callback,
+                          NULL,
+                          0,
+                          0,
+                          &netconf_rpc_subscription);
+    if (rc != SR_ERR_OK) {
+        log_error("Failed to subscribe to F1 handover RPC: %s", sr_strerror(rc));
+        return 1;
+    }
+
+    // Subscribe to N2 handover RPC on the same subscription context
+    rc = sr_rpc_subscribe(netconf_session_running,
+                          "/oai-handover:trigger-n2-handover",
+                          netconf_data_n2_handover_rpc_callback,
+                          NULL,
+                          0,
+                          0, // SR_SUBSCR_CTX_REUSE,
+                          &netconf_rpc_subscription);
+    if (rc != SR_ERR_OK) {
+        log_error("Failed to subscribe to N2 handover RPC: %s", sr_strerror(rc));
+        sr_unsubscribe(netconf_rpc_subscription);
+        netconf_rpc_subscription = 0;
+        return 1;
+    }
+
+    log("Handover RPCs registered successfully");
+    return 0;
+}
