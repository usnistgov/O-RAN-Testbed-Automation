+      data_item.meas_record_lst[rec_idx++] = get_kpm_meas_value(meas_info_name_str, gran_period_ms, ue_info, ue_idx, node_stats);
+    }
 
     free(meas_info_name_str);
   }
 
+  set_kpm_label_info(NULL);
+
   return data_item;
 }
 
