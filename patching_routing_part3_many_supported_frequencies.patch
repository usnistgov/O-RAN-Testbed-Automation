diff --git a/Next_Generation_Node_B/run_background.sh b/Next_Generation_Node_B/run_background.sh
index 33b0965..7f058cb 100755
--- a/Next_Generation_Node_B/run_background.sh
+++ b/Next_Generation_Node_B/run_background.sh
@@ -67,20 +67,51 @@ else
     sudo -v # Ensure sudo session is active
     sudo env $ZMQ_BROKER_UI_ENV setsid bash -c "stdbuf -oL -eL \"$SCRIPT_DIR/run.sh\" >/dev/null 2>&1" </dev/null &
 
+    GNB_READY_MODE="${GNB_READY_MODE:-n2}" # Supported: n2, started
+    if [ "$GNB_READY_MODE" != "n2" ] && [ "$GNB_READY_MODE" != "started" ]; then
+        echo "ERROR: Unsupported GNB_READY_MODE '$GNB_READY_MODE'. Supported: n2, started."
+        exit 1
+    fi
+    # https://gitlab.com/ocudu/ocudu/-/blob/dev/apps/services/application_message_banners.h
+    READY_RE='====[[:space:]]+gNB started[[:space:]]+==='
+    N2_READY_RE='N2: Connection to AMF on .* completed'
+    ERROR_RE='OCUDU ERROR:|ERROR:|Error:|error:|FATAL|Fatal|fatal|Failed to|failed to|Invalid .*configuration|Assertion|assertion'
+
     ATTEMPT=0
-    # while [ ! -f logs/gnb_stdout.txt ] || ! grep -q "gNB started" logs/gnb_stdout.txt; do
-    while [ ! -f logs/gnb_stdout.txt ] || ! (grep -q "gNB started" logs/gnb_stdout.txt || grep -q -E "N2: Connection to AMF on .* completed" logs/gnb_stdout.txt); do
+    while [ ! -f logs/gnb_stdout.txt ] ||
+        { [ "$GNB_READY_MODE" = "started" ] && ! grep -qE "$READY_RE" logs/gnb_stdout.txt; } ||
+        { [ "$GNB_READY_MODE" = "n2" ] && ! grep -qE "$N2_READY_RE" logs/gnb_stdout.txt; }; do
         sleep 0.5
         ATTEMPT=$((ATTEMPT + 1))
-        if [ $ATTEMPT -ge 120 ]; then
-            echo "gNodeB did not start after 60 seconds, exiting..."
+
+        if [ -f logs/gnb_stdout.txt ] && grep -qE "$ERROR_RE" logs/gnb_stdout.txt; then
+            echo "gNodeB failed to start. Recent stdout:"
+            tail -n 80 logs/gnb_stdout.txt
             exit 1
         fi
-        if [ -f logs/gnb_stdout.txt ] && (grep -q "Error" logs/gnb_stdout.txt || grep -q "OCUDU ERROR:" logs/gnb_stdout.txt); then
-            echo "Error starting gNodeB. Check logs/gnb_stdout.txt for more information."
+
+        if [ $ATTEMPT -ge 120 ]; then
+            echo "gNodeB did not report $GNB_READY_MODE readiness after 60 seconds."
+            if [ "$GNB_READY_MODE" = "started" ]; then
+                echo "The gNodeB may have connected to the AMF but not finished DU/RU startup."
+            fi
+            echo
+            echo "Recent stdout:"
+            [ -f logs/gnb_stdout.txt ] && tail -n 120 logs/gnb_stdout.txt
+            if [ -s logs/gnb.log ]; then
+                echo
+                echo "Recent gNB log:"
+                tail -n 120 logs/gnb.log
+            fi
             exit 1
         fi
     done
 
+    if [ "$USE_ZMQ_BROKER" != "true" ]; then
+        # N2 and process startup can come up before the direct ZMQ radio path is necessarily ready.
+        # Give the DU/RU side a short, deterministic settle window before UE startup.
+        sleep "${DIRECT_ZMQ_GNB_SETTLE_SECONDS:-5}"
+    fi
+
     ./is_running.sh
 fi
