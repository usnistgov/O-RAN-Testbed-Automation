+/*!
+ * \brief       procedures related to gNB for the DLSCH transport channel
+ */
+
+#include "common/utils/nr/nr_common.h"
+/*MAC*/
+#include "NR_MAC_COMMON/nr_mac.h"
+#include "NR_MAC_gNB/nr_mac_gNB.h"
