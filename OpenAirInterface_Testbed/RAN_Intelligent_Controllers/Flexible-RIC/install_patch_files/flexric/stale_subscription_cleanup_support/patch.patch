+void rm_stale_allocations_sync_xapp(e42_xapp_t* xapp, uint16_t ran_func_id) {
+  assert(xapp != NULL);
+  for (uint32_t id = 1; id <= MAX_STALE_SWEEPS; ++id) {
+    ric_gen_id_t ric_id = {.ric_req_id = id, .ric_inst_id = 0, .ran_func_id = ran_func_id};
+    send_ric_subscription_delete(xapp, ric_id);
+    usleep(1000);
+  }
+}
