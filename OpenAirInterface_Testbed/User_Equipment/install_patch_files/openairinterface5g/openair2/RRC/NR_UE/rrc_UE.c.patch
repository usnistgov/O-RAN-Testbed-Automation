+static void start_periodical_meas_reporting(rrcPerNB_t *rrc)
+{
+  for (int i = 0; i < MAX_MEAS_ID; i++) {
+    const NR_MeasIdToAddMod_t *meas_id = rrc->MeasId[i];
+    if (!meas_id)
+      continue;
+    const NR_ReportConfigToAddMod_t *report = rrc->ReportConfig[meas_id->reportConfigId];
+    if (!report || report->reportConfig.present != NR_ReportConfigToAddMod__reportConfig_PR_reportConfigNR)
+      continue;
+    const NR_ReportConfigNR_t *report_nr = report->reportConfig.choice.reportConfigNR;
+    if (report_nr->reportType.present != NR_ReportConfigNR__reportType_PR_periodical)
+      continue;
+
+    const NR_PeriodicalReportConfig_t *periodical = report_nr->reportType.choice.periodical;
+    l3_measurements_t *l3_measurements = &rrc->l3_measurements;
+    l3_measurements->trigger_to_measid = meas_id->measId;
+    l3_measurements->trigger_quantity = NR_MeasTriggerQuantityOffset_PR_rsrp;
+    l3_measurements->rs_type = periodical->rsType;
+    l3_measurements->reports_sent = 0;
+    l3_measurements->max_reports =
+        periodical->reportAmount == NR_PeriodicalReportConfig__reportAmount_infinity
+            ? INT_MAX
+            : (1 << periodical->reportAmount);
+    l3_measurements->report_interval_ms = get_measurement_report_interval_ms(periodical->reportInterval);
+    l3_measurements->neighbor_cell_valid = false;
+    nr_timer_setup(&l3_measurements->periodic_report_timer, l3_measurements->report_interval_ms, 10);
+    nr_timer_start(&l3_measurements->periodic_report_timer);
+    LOG_I(NR_RRC,
+          "Started periodical measurement reporting for measId %ld every %ld ms\n",
+          meas_id->measId,
+          l3_measurements->report_interval_ms);
+    return;
+  }
+}
