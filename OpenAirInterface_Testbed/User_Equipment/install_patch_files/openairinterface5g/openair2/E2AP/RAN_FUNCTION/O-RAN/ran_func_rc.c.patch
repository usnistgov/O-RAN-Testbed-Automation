+typedef struct {
+  uint32_t ric_req_id;
+  rc_ind_data_t *ind;
+} delayed_rc_ind_t;
+
+static void *send_delayed_rc_ind(void *data)
+{
+  delayed_rc_ind_t *delayed = data;
+  usleep(10000);
+  send_aper_ric_ind(delayed->ric_req_id, delayed->ind);
+  free(delayed);
+  return NULL;
+}
+
+static bool schedule_rc_ind(uint32_t ric_req_id, rc_ind_data_t *ind)
+{
+  delayed_rc_ind_t *delayed = calloc_or_fail(1, sizeof(*delayed));
+  delayed->ric_req_id = ric_req_id;
+  delayed->ind = ind;
+
+  pthread_t thread;
+  const int rc = pthread_create(&thread, NULL, send_delayed_rc_ind, delayed);
+  if (rc != 0) {
+    free(delayed);
+    return false;
+  }
+  assert(pthread_detach(thread) == 0);
+  return true;
+}
