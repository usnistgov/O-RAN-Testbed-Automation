+double get_sinr_percentile_val(uint32_t *dist, size_t index)
+{
+  uint32_t cumulative = 0;
+  for (int i = 0; i < 128; i++)
+  {
+    cumulative += dist[i];
+    if (cumulative > index)
+    {
+      if (i == 0)
+        return -23.5;
+      return -23.5 + 0.5 * i;
+    }
+  }
+  return 40.0;
+}
+
+int get_percentile_val(uint32_t *dist, size_t index)
+{
+  uint32_t cumulative = 0;
+  for (int i = 0; i < 128; i++)
+  {
+    cumulative += dist[i];
+    if (cumulative > index)
+    {
+      // 38.133 Table 10.1.6.1-1: SS-RSRP and CSI-RSRP measurement report mapping
+      return -(156 + 1) + i;
+    }
+  }
+  return -(156 + 1) + 127;
+}
