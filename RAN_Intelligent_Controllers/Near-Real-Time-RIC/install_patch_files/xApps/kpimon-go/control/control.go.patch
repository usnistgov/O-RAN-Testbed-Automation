+func (c Control) initializeNode(nb *xapp.RNIBNbIdentity) bool {
+	xapp.Logger.Info("Building KPI metadata for %v", nb.InventoryName)
+	link := "http://service-ricplt-e2mgr-http.ricplt.svc.cluster.local:3800/v1/nodeb/" + nb.InventoryName
+	tmpr, err := http.Get(link)
+	if err != nil {
+		xapp.Logger.Error("Unable to read E2 node %s from E2Mgr: %v", nb.InventoryName, err)
+		return false
+	}
+	defer tmpr.Body.Close()
+	if tmpr.StatusCode != http.StatusOK {
+		xapp.Logger.Error("E2Mgr returned %s for E2 node %s", tmpr.Status, nb.InventoryName)
+		return false
+	}
+
+	var resp E2mgrResponse
+	if err = json.NewDecoder(tmpr.Body).Decode(&resp); err != nil {
+		xapp.Logger.Error("Unable to decode E2 node %s from E2Mgr: %v", nb.InventoryName, err)
+		return false
+	}
+
+	counter := -1
+	for i := 0; i < len(resp.Gnb.RanFunctions); i++ {
+		if resp.Gnb.RanFunctions[i].RanFunctionId == int(funcId) {
+			counter = i
+			break
+		}
+	}
+	if counter == -1 {
+		xapp.Logger.Error("E2 node %s does not advertise RAN function %d", nb.InventoryName, funcId)
+		return false
+	}
+	cString := C.CString(resp.Gnb.RanFunctions[counter].RanFunctionDefinition)
+	defer C.free(unsafe.Pointer(cString)) // Free the allocated C string when done
