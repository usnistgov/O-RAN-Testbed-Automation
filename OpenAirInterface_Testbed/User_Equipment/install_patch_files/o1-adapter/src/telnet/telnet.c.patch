index 1d2c764..1e6a581 100644
--- a/src/telnet/telnet.c
+++ b/src/telnet/telnet.c
@@ -694,3 +694,71 @@ failed:
 
 	return 1;
 }
+int telnet_trigger_f1_handover(int rrc_ue_id) {
+	char *response = 0;
+	int rc = 0;
+	char buffer[128];
+
+	telnet_lock();
+
+	const char *tokens[] = {"softmodem_gnb> ", 0};
+	
+	if(rrc_ue_id < 0) {
+		rc = telnet_write("ci trigger_f1_ho\n", 10, tokens, &response);
+	} else {
+		sprintf(buffer, "ci trigger_f1_ho %d\n", rrc_ue_id);
+		rc = telnet_write(buffer, 10, tokens, &response);
+	}
+	
+	if(rc != 0) {
+		log_error("telnet_write failed");
+		goto failed;
+	}
+
+	if(strstr(response, "FAIL") || strstr(response, "ERROR")) {
+		log_error("F1 handover trigger failed: %s", response);
+		goto failed;
+	}
+	
+	log("F1 handover triggered successfully: %s", response);
+	free(response);
+	telnet_unlock();
+	return 0;
+
+failed:
+	telnet_unlock();
+	free(response);
+	return 1;
+}
+
+int telnet_trigger_n2_handover(int neighbour_pci, int ue_id) {
+	char *response = 0;
+	int rc = 0;
+	char buffer[128];
+
+	telnet_lock();
+
+	const char *tokens[] = {"softmodem_gnb> ", 0};
+	sprintf(buffer, "ci trigger_n2_ho %d %d\n", neighbour_pci, ue_id);
+	rc = telnet_write(buffer, 10, tokens, &response);
+	
+	if(rc != 0) {
+		log_error("telnet_write failed");
+		goto failed;
+	}
+
+	if(strstr(response, "FAIL") || strstr(response, "ERROR")) {
+		log_error("N2 handover trigger failed: %s", response);
+		goto failed;
+	}
+	
+	log("N2 handover triggered successfully: %s", response);
+	free(response);
+	telnet_unlock();
+	return 0;
+
+failed:
+	telnet_unlock();
+	free(response);
+	return 1;
+}
