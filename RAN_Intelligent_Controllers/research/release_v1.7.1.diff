+typedef kpm_act_def_t (*fill_kpm_act_def)(ric_report_style_item_t const* report_item);
+
+static
+fill_kpm_act_def get_kpm_act_def[END_RIC_SERVICE_REPORT] =
+{
+    NULL,
+    NULL,
+    NULL,
+    fill_report_style_4,
+    NULL,
+};
