+static
+tc_ctrl_msg_t gen_mod_bdp_pcr(void)
+{
+     	tc_ctrl_msg_t ans = {.type = TC_CTRL_SM_V0_PCR,  
+		.pcr.act = TC_CTRL_ACTION_SM_V0_MOD};  
+
+       	ans.pcr.mod.type = TC_PCR_5G_BDP; 
+      	ans.pcr.mod.bdp.tstamp = time_now_us(); 
+      	ans.pcr.mod.bdp.drb_sz = 25000; 
+      	return ans;
+}
