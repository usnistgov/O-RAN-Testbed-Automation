+static rc_ind_data_t *fill_du_common_information(void)
+{
+  if (RC.nrmac == NULL || RC.nrmac[0] == NULL || RC.nrmac[0]->f1_config.setup_req == NULL) {
+    printf("[E2 AGENT] DU cell information is unavailable\n");
+    return NULL;
+  }
+
+  const f1ap_setup_req_t *setup = RC.nrmac[0]->f1_config.setup_req;
+  rc_ind_data_t *ind = calloc_or_fail(1, sizeof(*ind));
+  ind->hdr.format = FORMAT_1_E2SM_RC_IND_HDR;
+  ind->msg.format = FORMAT_4_E2SM_RC_IND_MSG;
+  ind->msg.frmt_4.sz_seq_cell_info_2 = setup->num_cells_available;
+  ind->msg.frmt_4.seq_cell_info_2 = calloc_or_fail(setup->num_cells_available,
+                                                   sizeof(*ind->msg.frmt_4.seq_cell_info_2));
+
+  for (size_t i = 0; i < setup->num_cells_available; ++i) {
+    const f1ap_served_cell_info_t *cell = &setup->cell[i].info;
+    cell_global_id_t *cgi = &ind->msg.frmt_4.seq_cell_info_2[i].cell_global_id;
+    cgi->type = NR_CGI_RAT_TYPE;
+    cgi->nr_cgi.plmn_id.mcc = cell->plmn.mcc;
+    cgi->nr_cgi.plmn_id.mnc = cell->plmn.mnc;
+    cgi->nr_cgi.plmn_id.mnc_digit_len = cell->plmn.mnc_digit_length;
+    cgi->nr_cgi.nr_cell_id = cell->nr_cellid;
+  }
+
+  return ind;
+}
