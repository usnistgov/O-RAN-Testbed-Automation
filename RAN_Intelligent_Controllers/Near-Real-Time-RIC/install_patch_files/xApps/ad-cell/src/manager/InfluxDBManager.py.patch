+    def _query_measurement(self, client, measurement) -> pd.DataFrame:
+        influxdb_bucket = config.get('APP', 'INFLUX_BUCKET')
+        flux_query = f'''
+        from(bucket: "{influxdb_bucket}")
+            |> range(start: -48h)
+            |> filter(fn: (r) => r["_measurement"] == "{measurement}")
+            |> pivot(rowKey:["_time"], columnKey: ["_field"], valueColumn: "_value")
+        '''
+        return self._normalize_query_result(client.query_api().query_data_frame(flux_query))
+
+    def _query_kpimon_cell_metrics(self, client) -> pd.DataFrame:
+        df = self._query_measurement(client, "cellMetrics")
+        if df.empty:
+            return df
+
+        adapted = pd.DataFrame(index=df.index)
+        adapted["Short name"] = self._cell_name(df)
+
+        for target_column, source_columns in KPIMON_CELL_FIELD_MAP.items():
+            adapted[target_column] = self._first_available_numeric(df, source_columns, AD_CELL_DEFAULTS[target_column])
+
+        adapted["DL Volume (GB)"] = self._volume_gb(df, DL_VOLUME_FIELDS, AD_CELL_DEFAULTS["DL Volume (GB)"])
+        adapted["UL Volume (GB)"] = self._volume_gb(df, UL_VOLUME_FIELDS, AD_CELL_DEFAULTS["UL Volume (GB)"])
+        adapted["Avg. DL PRB Utilization"] = self._prb_utilization(
+            df,
+            DL_PRB_USED_FIELDS,
+            DL_PRB_TOTAL_FIELDS,
+            DL_PRB_AVAILABLE_FIELDS,
+            AD_CELL_DEFAULTS["Avg. DL PRB Utilization"],
+        )
+        adapted["Avg. UL PRB Utilization"] = self._prb_utilization(
+            df,
+            UL_PRB_USED_FIELDS,
+            UL_PRB_TOTAL_FIELDS,
+            UL_PRB_AVAILABLE_FIELDS,
+            AD_CELL_DEFAULTS["Avg. UL PRB Utilization"],
+        )
+
+        for target_column, default_value in AD_CELL_DEFAULTS.items():
+            if target_column not in adapted.columns:
+                adapted[target_column] = default_value
+
+        log.info("Adapted kpimon cellMetrics rows to the g-nodeb schema expected by ad-cell.")
+        return adapted[["Short name"] + list(AD_CELL_DEFAULTS.keys())]
+
+    def _normalize_query_result(self, result) -> pd.DataFrame:
+        if isinstance(result, list):
+            result = pd.concat(result, ignore_index=False) if result else pd.DataFrame()
+        if result.empty:
+            return pd.DataFrame()
+        return result.drop(
+            columns=[
+                col
+                for col in ["table", "_start", "_stop", "_time", "_measurement", "result"]
+                if col in result.columns
+            ]
+        )
+
+    def _cell_name(self, df) -> pd.Series:
+        for column in CELL_NAME_FIELDS:
+            if column in df.columns:
+                return df[column].astype(str)
+        return pd.Series(["cell-unknown"] * len(df), index=df.index)
+
+    def _first_available_numeric(self, df, columns, default_value) -> pd.Series:
+        for column in columns:
+            if column in df.columns:
+                return pd.to_numeric(df[column], errors="coerce").fillna(default_value)
+        return pd.Series([default_value] * len(df), index=df.index)
+
+    def _volume_gb(self, df, columns, default_value) -> pd.Series:
+        for column in columns:
+            if column in df.columns:
+                volume_gb = pd.to_numeric(df[column], errors="coerce") / 1_000_000_000
+                return volume_gb.fillna(default_value)
+        return pd.Series([default_value] * len(df), index=df.index)
+
+    def _prb_utilization(self, df, used_columns, total_columns, available_columns, default_value) -> pd.Series:
+        if not self._has_any_column(df, used_columns):
+            return pd.Series([default_value] * len(df), index=df.index)
+
+        used = self._first_available_numeric(df, used_columns, default_value)
+        if self._has_any_column(df, total_columns):
+            total = self._first_available_numeric(df, total_columns, default_value)
+        elif self._has_any_column(df, available_columns):
+            available = self._first_available_numeric(df, available_columns, default_value)
+            total = used + available
+        else:
+            return used
+
+        total = total.replace(0, pd.NA)
+        utilization = (used / total) * 100
+        return utilization.fillna(default_value)
+
+    @staticmethod
+    def _has_any_column(df, columns) -> bool:
+        return any(column in df.columns for column in columns)
+
