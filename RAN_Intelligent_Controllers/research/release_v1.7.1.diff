+kpm_ind_hdr_t kpm_ind_hdr(void)
+{
+  kpm_ind_hdr_t hdr = {0};
+
+  hdr.type = FORMAT_1_INDICATION_HEADER;
+  hdr.kpm_ric_ind_hdr_format_1 = kpm_ind_hdr_frm_1();
+
+  return hdr;
+}
